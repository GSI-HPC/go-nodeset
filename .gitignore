# Personal instructions for coding agents
/AGENTS.local.md
/CLAUDE.local.md

# Agent state; the shared skills live in .agents/skills, and .claude/skills
# links to them
/.claude/*
!/.claude/skills

# Personal mise overrides
/mise.local.toml

# A workspace for developing against local checkouts of a consumer is never
# committed, and neither is a replace directive
go.work
go.work.sum

# Test and coverage output
*.out
*.test
coverage.html

# Markdown linting
node_modules/

# The ClusterShell that make clustershell installs
/.clustershell/
